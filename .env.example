# Postgres connection (docker-compose default below)
DATABASE_URL=postgres://pos:pos@localhost:5432/pos

# Secret used to sign JWT session cookies. MUST be changed in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Owner/Manager session lifetime (hours). Default 12.
SESSION_HOURS=12

# Used by scripts/seed.ts for the initial Owner account
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=owner1234
SEED_OWNER_NAME=مالک نمونه
