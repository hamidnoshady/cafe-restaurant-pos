# Environment for the Komodo + Traefik production stack
# (docker-compose.komodo.yml). In Komodo, paste these into the Stack's
# Environment section rather than committing a filled-in copy.

# --- Public URL ---------------------------------------------------------------
# The subdomain Traefik will serve the POS on (HTTPS). Must already point at
# the server and be covered by your Traefik certresolver.
POS_DOMAIN=pos.example.com

# --- Secrets ------------------------------------------------------------------
# Signs the JWT session cookie. MUST be a real random value in production.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# Postgres password for the app's own database (the stack creates this DB).
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Postgres (optional overrides) --------------------------------------------
POSTGRES_USER=pos
POSTGRES_DB=pos

# --- Per-business subdomains (Phase 21) ---------------------------------------
# The zone every business origin hangs off. Businesses are served from
# {subdomain}.$ROOT_DOMAIN, the console from admin.$ROOT_DOMAIN, and the bare
# domain is a "which business?" router. Usually the same as POS_DOMAIN.
ROOT_DOMAIN=pos.example.com

# Off until the wildcard certificate is confirmed issuing. Let's Encrypt will
# not issue *.$ROOT_DOMAIN over HTTP-01, so TRAEFIK_CERTRESOLVER below must be
# a resolver configured with a DNS-01 provider credential for the zone. Flip to
# `on` once `*.$ROOT_DOMAIN` is serving a valid certificate.
SUBDOMAIN_ROUTING=off

# --- Deployment role (Phase 21) -----------------------------------------------
# This stack IS the central server: sites sync to it, it syncs to nothing. The
# Server Sync tab drops the connection form here and PUT /api/server-sync/config
# refuses. Set explicitly rather than relying on the POS_DOMAIN inference.
DEPLOYMENT_ROLE=central

# --- Sessions (optional) ------------------------------------------------------
# Owner/Manager session lifetime in hours.
SESSION_HOURS=12

# --- Traefik wiring -----------------------------------------------------------
# The name of the existing external Docker network your Traefik runs on.
# (Komodo's bundled Traefik commonly uses "traefik".)
TRAEFIK_NETWORK=traefik
# The Traefik entrypoint that terminates TLS (usually "websecure").
TRAEFIK_ENTRYPOINT=websecure
# The Traefik certresolver that issues the cert for ROOT_DOMAIN and
# *.ROOT_DOMAIN (e.g. "letsencrypt", or whatever you named it in Traefik's
# static config). Since Phase 21 this MUST be a DNS-01 resolver: ACME will not
# issue a wildcard over an HTTP-01 challenge, so an HTTP-01 resolver will fail
# to obtain the certificate the per-business hosts need.
TRAEFIK_CERTRESOLVER=letsencrypt
