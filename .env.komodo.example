# Environment for the Komodo + Traefik production stack
# (docker-compose.komodo.yml). In Komodo, paste these into the Stack's
# Environment section rather than committing a filled-in copy.

# --- Public URL ---------------------------------------------------------------
# The subdomain Traefik will serve the POS on (HTTPS). Must already point at
# the server and be covered by your Traefik certresolver.
POS_DOMAIN=pos.example.com

# --- Secrets ------------------------------------------------------------------
# Signs the JWT session cookie. MUST be a real random value in production.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# Postgres password for the app's own database (the stack creates this DB).
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Postgres (optional overrides) --------------------------------------------
POSTGRES_USER=pos
POSTGRES_DB=pos

# --- Sessions (optional) ------------------------------------------------------
# Owner/Manager session lifetime in hours.
SESSION_HOURS=12

# --- Traefik wiring -----------------------------------------------------------
# The name of the existing external Docker network your Traefik runs on.
# (Komodo's bundled Traefik commonly uses "traefik".)
TRAEFIK_NETWORK=traefik
# The Traefik entrypoint that terminates TLS (usually "websecure").
TRAEFIK_ENTRYPOINT=websecure
# The Traefik certresolver that issues the cert for POS_DOMAIN
# (e.g. "letsencrypt", or whatever you named it in Traefik's static config).
TRAEFIK_CERTRESOLVER=letsencrypt
