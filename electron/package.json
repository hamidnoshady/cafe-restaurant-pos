{
  "name": "cafe-pos-desktop",
  "version": "1.0.0",
  "private": true,
  "author": "Cafe POS",
  "description": "Standalone Windows installer for the Cafe/Restaurant POS — no Docker, no Docker Desktop, no manual database setup.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/prepare-wincodesign-cache.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "embedded-postgres": "16.14.0-beta.17"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.cafepos.desktop",
    "productName": "Cafe POS",
    "asar": true,
    "files": ["main.js", "preload.js", "package.json"],
    "win": {
      "target": "nsis",
      "icon": "../windows/cafe-pos.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      { "from": "../.next", "to": "app/.next" },
      { "from": "../public", "to": "app/public" },
      { "from": "../src", "to": "app/src" },
      { "from": "../migrations", "to": "app/migrations" },
      { "from": "../scripts", "to": "app/scripts" },
      { "from": "../server.ts", "to": "app/server.ts" },
      { "from": "../next.config.ts", "to": "app/next.config.ts" },
      { "from": "../tsconfig.json", "to": "app/tsconfig.json" },
      { "from": "../package.json", "to": "app/package.json" },
      {
        "from": "../node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*",
          "!**/typescript{,/**}",
          "!**/vitest{,/**}",
          "!**/tailwindcss{,/**}",
          "!**/@tailwindcss{,/**}",
          "!**/@types{,/**}",
          "!**/.bin{,/**}",
          "!**/.cache{,/**}"
        ]
      }
    ]
  }
}
